# Luma environment template
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Values marked "required now" are used by implemented runtime code.
# Values marked "planned" document the expected config shape for upcoming integrations.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Optional. Defaults to development.
NODE_ENV=development

# Optional. Defaults to Europe/Berlin.
# Used for relative date normalization and workspace defaults.
LUMA_DEFAULT_WORKSPACE_TIMEZONE=Europe/Berlin

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

# Planned for the production PostgreSQL adapter.
# The current test/foundation slice uses PGlite in process.
DATABASE_URL=postgres://luma:luma@localhost:5432/luma

# -----------------------------------------------------------------------------
# GitHub Issues WorkProvider
# -----------------------------------------------------------------------------

# Required now for live GitHub Issues integration.
# You can either paste a token here or export one from the GitHub CLI:
#   export GITHUB_TOKEN="$(gh auth token)"
GITHUB_TOKEN=

# Required now for live GitHub Issues integration.
# Format: owner/repo
# If this repo has a GitHub remote, you can derive it with:
#   gh repo view --json nameWithOwner -q .nameWithOwner
GITHUB_REPOSITORY=owner/repo

# Optional. Defaults to https://api.github.com.
GITHUB_API_BASE_URL=https://api.github.com

# Optional. Provider ID stored in ExternalReference.providerId.
LUMA_GITHUB_WORK_PROVIDER_ID=github-issues

# Optional. Sent as GitHub REST User-Agent.
LUMA_GITHUB_USER_AGENT=luma-meeting-intelligence

# Optional. Enables the non-mutating live GitHub WorkProvider smoke test.
# Leave unset or 0 for normal local/CI verification.
LUMA_LIVE_GITHUB_TESTS=0

# -----------------------------------------------------------------------------
# GitHub CodeProvider
# -----------------------------------------------------------------------------

# Planned. GitHub code context remains separate from GitHub Issues work tracking.
LUMA_GITHUB_CODE_PROVIDER_ID=github-code

# -----------------------------------------------------------------------------
# Confluence KnowledgeProvider
# -----------------------------------------------------------------------------

# Planned. Meeting Intelligence does not depend on Confluence directly; the
# KnowledgeProvider Adapter will use these when implemented.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_ID=
LUMA_CONFLUENCE_PROVIDER_ID=confluence

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------

# Planned. Discord remains the meeting surface; Discord SDK types must not leak
# into Meeting Intelligence public models.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# -----------------------------------------------------------------------------
# ReasoningModel Adapter
# -----------------------------------------------------------------------------

# Planned. Model SDKs sit behind the owned ReasoningModel port.
OPENAI_API_KEY=
LUMA_REASONING_MODEL_PROVIDER=openai
LUMA_REASONING_MODEL_NAME=

