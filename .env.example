# Luma environment template
#
# Copy this file to `.env` for local development. Never commit `.env`.
# Configure only the integrations used in this environment. The Discord runtime
# starts without Linear, Notion, or OpenAI credentials, but related capabilities
# remain unavailable until their complete variable group is present.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Optional. Defaults to development.
NODE_ENV=development

# Optional. Defaults to Europe/Berlin.
# Used for relative date normalization and workspace defaults.
LUMA_DEFAULT_WORKSPACE_TIMEZONE=Europe/Berlin

# Optional. Internal workspace identifier for the configured Discord server.
LUMA_WORKSPACE_ID=workspace_dayova

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

# Optional. Durable local PGlite directory used by the executable Discord bot.
# Defaults to .luma/pglite and is ignored by git.
LUMA_PGLITE_DATA_DIR=.luma/pglite

# Planned for the production PostgreSQL adapter.
DATABASE_URL=postgres://luma:luma@localhost:5432/luma

# -----------------------------------------------------------------------------
# Linear WorkProvider (canonical executable work)
# -----------------------------------------------------------------------------

# Required together to create approved work items in Linear.
LINEAR_API_KEY=
LINEAR_TEAM_ID=63c160e7-ab70-4ef9-9822-0f85590ebb7f

# Optional. Dedicated Read-permission key for the bounded reconciliation
# catalog. It never falls back to LINEAR_API_KEY and must not grant write
# permission. The current executable does not wire this catalog by default;
# LUM-19 makes it available for an explicitly composed read-only surface.
LINEAR_READONLY_API_KEY=

# Optional. Defaults shown.
LINEAR_API_URL=https://api.linear.app/graphql
LUMA_LINEAR_PROVIDER_ID=linear

# Optional. Enables non-mutating live Adapter validation when set to 1.
LUMA_LIVE_LINEAR_READONLY_TESTS=0
LUMA_LIVE_LINEAR_TESTS=0

# -----------------------------------------------------------------------------
# Notion KnowledgeProvider (canonical meeting knowledge)
# -----------------------------------------------------------------------------

# Required together to write approved Meeting records to the Dayova Meetings
# data source. Share that data source with the Notion integration first.
NOTION_API_TOKEN=
NOTION_MEETINGS_DATA_SOURCE_ID=3982e872-28bf-8080-bf00-000b188b90d6

# Optional. These defaults match the Dayova Meetings data source.
NOTION_MEETINGS_TITLE_PROPERTY=Name
NOTION_MEETINGS_ATTENDEES_PROPERTY=Attendees
LUMA_NOTION_PROVIDER_ID=notion

# Optional. How often the executable drains the canonical Meeting Notes source.
# Defaults to 60000. Each run cursor-drains the whole data source and replays
# unchanged ledger revisions safely, so a failed delivery is retried.
LUMA_NOTION_MEETING_SYNC_INTERVAL_MS=60000

# Optional. Enables non-mutating live Adapter validation when set to 1.
LUMA_LIVE_NOTION_TESTS=0

# Optional. Enables the Meeting Notes source reliability proof. This path uses
# only read APIs, but the standard Notion connection must have read_content
# access to the canonical Meetings data source and its pages. Set the expected
# root Meeting Notes block ID to make the live assertion target a known fixture
# with a calendar attendee, summary, notes/action items, and transcript.
LUMA_LIVE_NOTION_MEETING_NOTES_TESTS=0
LUMA_NOTION_LIVE_MEETING_NOTES_BLOCK_ID=

# Dormant exact-page native-review proof (LUM-30). This is a separate Notion
# integration token with only read access to the one configured Meeting Note.
# It never falls back to NOTION_API_TOKEN and does not enable server/runtime
# ingress by itself. Set the live flag only for the opt-in one-page smoke test.
LUMA_NATIVE_NOTION_READONLY_API_TOKEN=
LUMA_NATIVE_NOTION_PAGE_ID=
LUMA_LIVE_NATIVE_NOTION_READONLY_TESTS=0

# -----------------------------------------------------------------------------
# GitHub App (code integration and Linear-synced compatibility Issues)
# -----------------------------------------------------------------------------

# GitHub Issues is available as a compatibility WorkProvider Adapter, but the
# configured Luma runtime creates new executable work in Linear. GitHub remains
# the source of truth for repositories, branches, commits, pull requests, and CI.
GITHUB_REPOSITORY=Dayova/dayova-mvp

# Preferred for production. These make GitHub activity appear as the GitHub App
# bot, not as Jakob or another human account.
#
# Required GitHub App repository permissions:
# - Metadata: read
# - Issues: read and write
#
# `GITHUB_APP_PRIVATE_KEY` can contain escaped newlines (`\n`).
# `GITHUB_APP_PRIVATE_KEY_BASE64` is often easier for single-line env stores.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Local GitHub Adapter fallback only. Activity made with this token is attributed
# to the token owner, not the bot. Prefer exporting the value from `gh`.
GITHUB_TOKEN=

# Optional. Defaults to https://api.github.com.
GITHUB_API_BASE_URL=https://api.github.com

# Optional. Provider ID stored in ExternalReference.providerId.
LUMA_GITHUB_WORK_PROVIDER_ID=github-issues

# Optional. Sent as GitHub REST User-Agent.
LUMA_GITHUB_USER_AGENT=luma-meeting-intelligence

# Optional. Enables the non-mutating live GitHub WorkProvider smoke test.
# Leave unset or 0 for normal local/CI verification.
LUMA_LIVE_GITHUB_TESTS=0

# -----------------------------------------------------------------------------
# Identity mapping
# -----------------------------------------------------------------------------

# Optional. JSON array of internal people and provider accounts.
# Entries extend the built-in Luma team mapping. A matching personId overrides
# that built-in entry; leaving the variable blank uses only the built-in team:
# - person_fabius  -> Discord, GitHub, Linear, and Notion accounts for Fabius
# - person_jakob   -> Discord, GitHub, Linear, and Notion accounts for Jakob
# - person_julius  -> Discord, GitHub, Linear, and Notion accounts for Julius
# - person_philipp -> Discord, GitHub, Linear, and Notion accounts for Philipp
#
# Example:
# LUMA_IDENTITY_PEOPLE_JSON='[{"personId":"person_other","displayName":"Other Person","discordUsername":"other_discord","discordUserId":"123456789012345678","githubLogin":"OtherGitHubLogin","languagePreference":"auto"}]'
LUMA_IDENTITY_PEOPLE_JSON=

# -----------------------------------------------------------------------------
# GitHub CodeProvider
# -----------------------------------------------------------------------------

# Planned. GitHub code context remains separate from Linear work tracking.
LUMA_GITHUB_CODE_PROVIDER_ID=github-code

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------

# Do not configure these for a Dayova or shared Discord Application until the
# LUM-4 activation gate is satisfied: its owner has recorded all four policy
# decisions and the required follow-up implementation is delivered. These
# variables are technical prerequisites, not authorization.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional, disabled-by-default bounded thread Context Ask. Do not set to 1
# until the LUM-4 activation gate is satisfied: its owner has recorded all
# four policy decisions and the required follow-up implementation is delivered.
# Message Content, this flag, and the technical channel/user scope below are
# prerequisites, not authorization.
# This captures an immutable current snapshot through the @Luma mention; it
# does not retain later Discord edit/deletion events.
LUMA_DISCORD_CONTEXT_ASK_ENABLED=0
# Required when enabled; comma-separated parent-channel IDs. Only public
# threads below these parents can trigger or supply Context Ask evidence.
LUMA_DISCORD_CONTEXT_ASK_PARENT_CHANNEL_IDS=
# Required when enabled; comma-separated Discord user IDs allowed to ask.
LUMA_DISCORD_CONTEXT_ASK_ALLOWED_DISCORD_USER_IDS=
# Strict bounded capture defaults. Values above the code's hard ceiling fail
# startup rather than broadening data access or model cost unexpectedly.
LUMA_DISCORD_CONTEXT_ASK_MAX_MESSAGES=50
LUMA_DISCORD_CONTEXT_ASK_MAX_EVIDENCE_CHARS=32000
LUMA_DISCORD_CONTEXT_ASK_MIN_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# ReasoningModel Adapter
# -----------------------------------------------------------------------------

# Optional. Without a key, evidence is persisted and analysis is deferred.
OPENAI_API_KEY=
LUMA_REASONING_MODEL_PROVIDER=openai
# Shared by Meeting analysis and optional Discord Context Ask. Blank values
# resolve to Luma's documented default, gpt-5.6-luna.
LUMA_REASONING_MODEL_NAME=gpt-5.6-luna
