# Luma's isolated automatic Notion Meeting Notes observer environment.
#
# Copy to `.env.notion-observation`; never add Discord, NOTION_API_TOKEN,
# LINEAR_API_KEY, or LUMA_NATIVE_NOTION_READONLY_API_TOKEN here. The executable
# rejects their presence before it opens its state store or listener.

NODE_ENV=development
LUMA_DEFAULT_WORKSPACE_TIMEZONE=Europe/Berlin

# A logical Luma workspace ID. It is intentionally not a Notion UUID.
LUMA_OBSERVATION_WORKSPACE_ID=workspace_dayova

# Dedicated read_content-only Notion connection for the canonical Meetings
# data source. These are activation-time deployment values, not development
# fallbacks from the ordinary Luma application.
LUMA_NOTION_OBSERVATION_READONLY_API_TOKEN=
LUMA_NOTION_OBSERVATION_MEETINGS_DATA_SOURCE_ID=
LUMA_NOTION_OBSERVATION_WORKSPACE_ID=
LUMA_NOTION_OBSERVATION_SUBSCRIPTION_ID=
LUMA_NOTION_OBSERVATION_INTEGRATION_ID=
LUMA_NOTION_OBSERVATION_WEBHOOK_VERIFICATION_TOKEN=

# This process must be the single canonical Meeting Notes source owner for its
# workspace/provider/data-source tuple. Do not share a PGlite directory with
# the Discord server or another observer process.
LUMA_NOTION_OBSERVATION_PGLITE_DATA_DIR=.luma/notion-observation
LUMA_NOTION_OBSERVATION_HTTP_HOST=127.0.0.1
LUMA_NOTION_OBSERVATION_HTTP_PORT=3001
LUMA_NOTION_OBSERVATION_HTTP_PATH=/notion/webhook
LUMA_NOTION_OBSERVATION_SYNC_INTERVAL_MS=60000

# Dedicated Linear Read-permission key. This catalog never falls back to a
# writer credential and exposes no mutation surface.
LINEAR_READONLY_API_KEY=
LINEAR_TEAM_ID=
LUMA_NOTION_OBSERVATION_LINEAR_API_URL=https://api.linear.app/graphql
LUMA_NOTION_OBSERVATION_LINEAR_PROVIDER_ID=linear

# Meeting analysis remains behind the owned ReasoningModel adapter. Set the
# provider to disabled only for deliberately evidence-only recovery work.
OPENAI_API_KEY=
LUMA_REASONING_MODEL_PROVIDER=openai
LUMA_REASONING_MODEL_NAME=gpt-5.6-luna
