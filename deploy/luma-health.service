[Unit]
Description=Luma runtime, Gateway and off-host backup health check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/luma/current
UnsetEnvironment=NODE_OPTIONS NODE_PATH
StateDirectory=luma-operations
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/flock --nonblock --no-fork /var/lib/luma-operations/health.lock /usr/bin/node /opt/luma/current/dist/src/app/operations-main.js monitor
TimeoutStartSec=90
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/luma-operations /var/backups/luma-operations
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=luma-health
