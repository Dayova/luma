# Secret-free template for the initial founders-only Discord deployment.
# Install the completed file as /etc/luma/production.env, root:root, mode 0600.
# Do not copy the development .env or put credentials into shell arguments.
NODE_ENV=production
LUMA_WORKSPACE_ID=workspace_dayova
LUMA_DEFAULT_WORKSPACE_TIMEZONE=Europe/Berlin
LUMA_PGLITE_DATA_DIR=/var/lib/luma/pglite
LUMA_RUNTIME_HEALTH_PATH=/var/lib/luma/runtime-health.json

# A separate production application, not Dayova Luma Dev (1526147284822392952).
# Enable Server Members Intent in its Developer Portal, even with Context Ask off.
# Preflight requires its approval; channel work requires a fresh complete reader
# proof (currently at most 999 guild members including bots). No cached fallback.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1086939783374315530

# Verified IDs on 9 September 2026: team-chat, team-chat-development, resources.
# Review effective readers and production-bot permissions before activation.
# Channel structure may change; replace these with the next explicitly reviewed scope.
LUMA_DISCORD_ALLOWED_PARENT_CHANNEL_IDS=1507049196006408352,1519252320343425135,1531388089824706652

# Enable only after participant notice, channel access review, and the production
# application's additional Message Content intent have been completed. No voice capture.
LUMA_DISCORD_CONTEXT_ASK_ENABLED=0
LUMA_DISCORD_CONTEXT_ASK_PARENT_CHANNEL_IDS=1507049196006408352,1519252320343425135,1531388089824706652
LUMA_DISCORD_CONTEXT_ASK_ALLOWED_DISCORD_USER_IDS=726409024894926869,779381502311137301,1376219174723911841,1492911575806251219
LUMA_DISCORD_CONTEXT_ASK_MAX_MESSAGES=50
LUMA_DISCORD_CONTEXT_ASK_MAX_EVIDENCE_CHARS=32000
LUMA_DISCORD_CONTEXT_ASK_MIN_INTERVAL_MS=60000

OPENAI_API_KEY=
LUMA_REASONING_MODEL_PROVIDER=openai
LUMA_REASONING_MODEL_NAME=gpt-5.6-luna
LUMA_AI_MONTHLY_LIMIT_USD=30
LUMA_AI_BUDGET_TIMEZONE=Europe/Berlin
LUMA_AI_WORKFLOW_LIMIT_USD=0.25
LUMA_AI_MAX_INPUT_TOKENS=100000
LUMA_AI_MAX_OUTPUT_TOKENS=8192
LUMA_AI_TIMEOUT_MS=60000

# Initial deployment has no Notion/Linear/GitHub credentials. Add an integration
# group only with its separately reviewed access and execution capability.
# The isolated Notion observer and native-review settings must not be injected here.

# Enable after source-owner sharing grants and dedicated read credentials exist.
# Without this, Ask has only its captured thread and Meeting state is local.
# See docs/configuration/organizational-context.md; do not reuse writer tokens.
LUMA_ORGANIZATIONAL_CONTEXT_ENABLED=0
# Set to /etc/luma/context-sharing.json when the protected policy exists.
LUMA_CONTEXT_SHARING_POLICY_PATH=
LUMA_GITHUB_CODE_READONLY_TOKEN=
LUMA_GITHUB_CODE_CREDENTIAL_SCOPE_ID=
LUMA_GITHUB_CODE_REPOSITORIES=
LUMA_CONTEXT_NOTION_READONLY_API_TOKEN=
LUMA_CONTEXT_NOTION_CREDENTIAL_SCOPE_ID=
LUMA_CONTEXT_NOTION_PAGE_IDS=
LUMA_CONTEXT_LINEAR_READONLY_API_KEY=
LUMA_CONTEXT_LINEAR_CREDENTIAL_SCOPE_ID=
LUMA_CONTEXT_LINEAR_TEAM_ID=

# Optional signed webhook latency for the main runtime's existing Notion source.
# Requires canonical source configuration, exact-page grants, a reviewed Notion
# subscription and HTTPS forwarding. No separate observer/store is started.
# See docs/operations/notion-webhook-runtime.md before activation.
LUMA_NOTION_WEBHOOK_ENABLED=0
LUMA_NOTION_WEBHOOK_WORKSPACE_ID=
LUMA_NOTION_WEBHOOK_SUBSCRIPTION_ID=
LUMA_NOTION_WEBHOOK_INTEGRATION_ID=
LUMA_NOTION_WEBHOOK_VERIFICATION_TOKEN=
LUMA_NOTION_WEBHOOK_HTTP_HOST=127.0.0.1
LUMA_NOTION_WEBHOOK_HTTP_PORT=3001
LUMA_NOTION_WEBHOOK_HTTP_PATH=/notion/webhook

# Explicit founder commands to create/update canonical Decision Records.
# Requires source notices and reviewed source/destination/authority grants.
# See docs/integrations/discord-decision-records.md. Disabled until provisioned.
LUMA_DISCORD_DECISION_RECORDS_ENABLED=0
LUMA_DISCORD_DECISION_RECORDS_PARENT_CHANNEL_IDS=1507049196006408352,1519252320343425135,1531388089824706652
LUMA_DISCORD_DECISION_RECORDS_ALLOWED_DISCORD_USER_IDS=726409024894926869,779381502311137301,1376219174723911841,1492911575806251219
LUMA_DISCORD_DECISION_RECORDS_MAX_MESSAGES=50
LUMA_DISCORD_DECISION_RECORDS_MAX_EVIDENCE_CHARS=32000
LUMA_DISCORD_DECISION_RECORDS_MIN_INTERVAL_MS=60000
LUMA_DECISION_RECORDS_NOTION_API_TOKEN=
LUMA_DECISION_RECORDS_DATA_SOURCE_ID=
LUMA_DECISION_RECORDS_CREDENTIAL_SCOPE_ID=
LUMA_DECISION_RECORDS_SIGNING_KEY=
# Set to /etc/luma/decision-authority.json when the protected policy exists.
LUMA_DECISION_AUTHORITY_POLICY_PATH=

# Shared Notion/Granola capture and separately approved Luma Synthesis publication.
# See docs/integrations/shared-meeting-capture-runtime.md.
LUMA_MEETING_CAPTURE_SYNTHESIS_ENABLED=0
LUMA_SYNTHESIS_NOTION_API_TOKEN=
LUMA_SYNTHESIS_IMPORTED_MEETINGS_DATA_SOURCE_ID=
LUMA_SYNTHESIS_CREDENTIAL_SCOPE_ID=
LUMA_SYNTHESIS_SIGNING_KEY=

# Per-founder browser OAuth. No personal meetings are shared until owner attestation.
LUMA_GRANOLA_OAUTH_ENABLED=0
# Set to /etc/luma/granola.key when the protected key exists.
LUMA_GRANOLA_CREDENTIAL_KEY_PATH=
LUMA_GRANOLA_OAUTH_REDIRECT_URI=
LUMA_GRANOLA_OAUTH_HTTP_HOST=127.0.0.1
LUMA_GRANOLA_OAUTH_HTTP_PORT=3002
