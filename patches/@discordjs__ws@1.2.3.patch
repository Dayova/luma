diff --git a/dist/defaultWorker.js b/dist/defaultWorker.js
index 306d691077f81e96bf977ed13aa1a962e13e5d0c..0f7c162fc945f818bac304e652b596d269310c0d 100644
--- a/dist/defaultWorker.js
+++ b/dist/defaultWorker.js
@@ -513,7 +513,11 @@ var WebSocketShard = class extends import_async_event_emitter.AsyncEventEmitter
         await promise;
         this.emit("closed" /* Closed */, { code: options.code });
       }
-      this.connection.onerror = null;
+      // A retired CONNECTING socket can still emit an asynchronous handshake
+      // error. Keep a terminal handler until it closes, and cancel its request.
+      this.connection.onerror = () => {};
+      if (this.connection.readyState === 0) this.connection.close();
+      this.connection = null;
     } else {
       this.debug(["Destroying a shard that has no connection; please open an issue on GitHub"]);
     }
